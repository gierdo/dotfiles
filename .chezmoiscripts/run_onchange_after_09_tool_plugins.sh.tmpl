#!/usr/bin/env bash
set -euo pipefail

if command -v herdr >/dev/null 2>&1; then
  plugins=(
    {{- range .packages.herdr.plugins }}
    {{ . | quote }}
    {{- end }}
  )

  for plugin in "${plugins[@]}"; do
    herdr plugin install "$plugin" -y || true
  done
fi

if command -v pi >/dev/null 2>&1; then
  extensions=(
    {{- range .packages.pi.extensions }}
    {{ . | quote }}
    {{- end }}
  )

  for extension in "${extensions[@]}"; do
    pi install "$extension" || true
  done
fi
