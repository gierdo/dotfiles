{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "forwardingTimeoutMs": 600000,
  "piInfrastructureReadPaths": [],
  "authorizerChain": [
    "subagent-inherit-manual"
  ],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".direnv/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.ppk": "deny",
      "id_rsa": "deny",
      "id_dsa": "deny",
      "id_ecdsa": "deny",
      "id_ed25519": "deny",
      "*id_rsa*": "deny",
      "~/.ssh/*": "deny",
      "*/.ssh/*": "deny",
      "~/.aws/credentials": "deny",
      "~/.aws/*": "deny",
      "*/.aws/credentials": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.kube/config": "deny",
      "~/.netrc": "deny",
      ".npmrc": "deny",
      ".pypirc": "deny",
      "credentials.json": "deny",
      "*credentials*.json": "deny",
      "*.credentials": "deny",
      "*.token": "deny",
      "secrets.*": "deny",
      "*secret*.yml": "deny",
      "*secret*.yaml": "deny"
    },
    "external_directory": "ask",
    "external_directory_read": {
      "*": "allow"
    },
    "external_directory_write": {
      "*": "ask",
      "/tmp/*": "allow",
      "/var/tmp/*": "allow",
      "~/.cache/*": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cd *": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "head": "allow",
      "herdr *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "which *": "allow",
      "type *": "allow",
      "env": "allow",
      "printenv*": "allow",
      "date": "allow",
      "whoami": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "realpath *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "column *": "allow",
      "jq *": "allow",
      "sed -n *": "allow",
      "awk *": "allow",
      "openspec *": "allow",
      "serena *": "allow",
      "sleep *": "allow",
      "tr *": "allow",
      "comm *": "allow",
      "printf *": "allow",
      "test *": "allow",
      "uv run": "ask",
      "uv run *": "ask",
      "rm -rf *": {
        "action": "deny",
        "reason": "Refusing recursive force delete; stage specific paths and confirm"
      },
      "rm -fr *": {
        "action": "deny",
        "reason": "Refusing recursive force delete; stage specific paths and confirm"
      },
      "dd *": {
        "action": "deny",
        "reason": "Raw disk write is not permitted"
      },
      "mkfs*": {
        "action": "deny",
        "reason": "Filesystem creation is not permitted"
      },
      "mkdir reviews/*": "allow",
      "mkdir -p reviews/*": "allow",
      "mkdir .workflow*": "allow",
      "mkdir -p .workflow*": "allow",
      "mkdir */.workflow*": "allow",
      "mkdir -p */.workflow*": "allow",
      "rm reviews/*": "allow",
      "rm -f reviews/*": "allow",
      "chmod -R *": "ask",
      "chown -R *": "ask",
      "sudo *": "deny",
      "git *": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git cat-file *": "allow",
      "git blame *": "allow",
      "git shortlog*": "allow",
      "git ls-files*": "allow",
      "git describe*": "allow",
      "git tag --list*": "allow",
      "git -C * status": "allow",
      "git -C * status *": "allow",
      "git -C * diff": "allow",
      "git -C * diff *": "allow",
      "git -C * log": "allow",
      "git -C * log *": "allow",
      "git -C * show": "allow",
      "git -C * show *": "allow",
      "git branch": "allow",
      "git branch --list*": "allow",
      "git branch --show-current": "allow",
      "git merge-base": "allow",
      "git merge-base *": "allow",
      "git remote -v *": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "git remote -v": "allow",
      "git stash list": "allow",
      "git grep *": "allow",
      "git -C * grep *": "allow",
      "git *grep *-O*": "ask",
      "git *grep *--open-files-in-pager*": "ask",
      "git rev-list *": "allow",
      "git -C * rev-list *": "allow",
      "git ls-tree *": "allow",
      "git -C * ls-tree *": "allow",
      "git -C * rev-parse *": "allow",
      "git -C * merge-base *": "allow",
      "git -C * blame *": "allow",
      "git -C * ls-files*": "allow",
      "git -C * cat-file *": "allow",
      "git worktree list*": "allow",
      "glab mr view*": "allow",
      "glab mr diff*": "allow",
      "glab mr list*": "allow",
      "glab ci list*": "allow",
      "glab ci view*": "allow",
      "glab ci status*": "allow",
      "glab ci trace*": "allow",
      "glab api": "ask",
      "glab api *": "ask",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git reset --hard *": "ask",
      "git clean -f*": "ask",
      "git clean -d*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git branch -D*": "ask",
      "git checkout -- *": "ask",
      "git stash drop*": "ask",
      "git stash clear": "ask",
      "pnpm *": "ask",
      "pnpm test*": "allow",
      "npx tsc*": "allow",
      "npm *": {
        "action": "deny",
        "reason": "Use pnpm instead"
      }
    },
    "mcp": {
      "mcp_status": "allow",
      "npx_*": "allow",
      "nvim_editor_mcp:*": "allow",
      "serena:initial_instructions": "allow",
      "serena:list_dir": "allow",
      "serena:find_file": "allow",
      "serena:read_file": "allow",
      "serena:search_for_pattern": "allow",
      "serena:get_symbols_overview": "allow",
      "serena:find_symbol": "allow",
      "serena:find_referencing_symbols": "allow",
      "serena:find_implementations": "allow",
      "serena:find_declaration": "allow",
      "serena:get_diagnostics_for_file": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "ls": "allow",
    "find": "allow",
    "subagent": "allow",
    "subagent_interrupt": "allow",
    "subagents_list": "allow",
    "subagent_resume": "allow",
    "subagent_done": "allow",
    "ctx_search": "allow",
    "ctx_resume": "allow",
    "ctx_stats": "allow",
    "ctx_execute": "allow",
    "codemode": "allow",
    "workflow_*": "allow",
    "list_mcp_resources": "allow",
    "list_mcp_resource_templates": "allow",
    "read_mcp_resource": "allow",
    "grep": "allow",
    "web_search": "allow",
    "google_search": "allow",
    "read_url_content": "allow",
    "fetch_content": "allow",
    "get_search_content": "allow",
    "web_enable": "allow"
  },
  "shellTools": {
    "exec_command": {
      "commandArgument": "cmd",
      "workdirArgument": "workdir"
    },
    "ctx_execute": {
      "commandArgument": "code"
    }
  }
}
