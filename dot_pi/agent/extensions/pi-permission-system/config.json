{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "forwardingTimeoutMs": 600000,
  "piInfrastructureReadPaths": [],
  "shellTools": {
    "exec_command": { "commandArgument": "cmd", "workdirArgument": "workdir" }
  },
  "authorizerChain": [],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".direnv/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.ppk": "deny",
      "id_rsa": "deny",
      "id_dsa": "deny",
      "id_ecdsa": "deny",
      "id_ed25519": "deny",
      "*id_rsa*": "deny",
      "~/.ssh/*": "deny",
      "*/.ssh/*": "deny",
      "~/.aws/credentials": "deny",
      "~/.aws/*": "deny",
      "*/.aws/credentials": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.kube/config": "deny",
      "~/.netrc": "deny",
      ".npmrc": "deny",
      ".pypirc": "deny",
      "credentials.json": "deny",
      "*credentials*.json": "deny",
      "*.credentials": "deny",
      "*.token": "deny",
      "secrets.*": "deny",
      "*secret*.yml": "deny",
      "*secret*.yaml": "deny"
    },

    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "ls": "allow",
    "find": "allow",
    "external_directory_read": "allow",
    "external_directory_write": "ask",
    "bash": {
      "*": "ask",

      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cd *": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "head": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "which *": "allow",
      "type *": "allow",
      "env": "allow",
      "printenv*": "allow",
      "date": "allow",
      "whoami": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "realpath *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "column *": "allow",
      "jq *": "allow",
      "sed -n *": "allow",
      "awk *": "allow",
      "sleep *": "allow",
      "python3 *": "ask",
      "node *": "allow",

      "rm -rf *": { "action": "deny", "reason": "Refusing recursive force delete; stage specific paths and confirm" },
      "rm -fr *": { "action": "deny", "reason": "Refusing recursive force delete; stage specific paths and confirm" },
      "dd *":     { "action": "deny", "reason": "Raw disk write is not permitted" },
      "mkfs*":    { "action": "deny", "reason": "Filesystem creation is not permitted" },
      "chmod -R *": "ask",
      "chown -R *": "ask",
      "sudo *":   "deny",
      "git *": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git -C * status": "allow",
      "git -C * status *": "allow",
      "git -C * diff": "allow",
      "git -C * diff *": "allow",
      "git -C * log": "allow",
      "git -C * log *": "allow",
      "git -C * show": "allow",
      "git -C * show *": "allow",
      "git branch": "allow",
      "git branch --list*": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "git remote -v": "allow",
      "git stash list": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git reset --hard *": "ask",
      "git clean -f*": "ask",
      "git clean -d*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git branch -D*": "ask",
      "git checkout -- *": "ask",
      "git stash drop*": "ask",
      "git stash clear": "ask",


      "pnpm install": "allow",
      "pnpm install *": "ask",
      "pnpm run *": "allow",
      "pnpm test*": "allow",
      "pnpm build*": "allow",
      "pnpm dlx *": "ask",
      "pnpm *": "ask",
      "npm *":  { "action": "deny", "reason": "Use pnpm instead" },
      "npx *":  { "action": "deny", "reason": "Use pnpm dlx instead" },
      "yarn *": { "action": "deny", "reason": "Use pnpm instead" },
      "bun *":  { "action": "deny", "reason": "Use pnpm instead" },

      "subagent *": "allow"
    },
    "mcp": {
      "mcp_status": "allow",
      "npx_*": "allow",
      "mcp__nvim_editor_mcp__*": "allow",
      "nvim_editor_mcp": "allow"
    },
    "skill": { "*": "allow" },
    "ctx_*": "allow",
    "grep": "allow",
    "external_directory": "ask"
  }
}
