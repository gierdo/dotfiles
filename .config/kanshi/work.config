profile default {
    output eDP-1 enable
}

profile dual {
    output eDP-1 enable position 2560,360
    output DP-1 enable position 0,0
}

profile dual-2 {
    output eDP-1 enable position 1920,0
    output HDMI-A-1 enable position 0,0
}

profile dual-8 {
    output eDP-1 enable position 3440,240
    output DP-8 enable position 0,0
}

profile man-dual {
    output DP-1 enable position 0,0 mode 2560x1440
    output DP-2 enable position 2560,0 mode 2560x1440
    output eDP-1 enable position 5120,360 mode 1920x1200
}

profile man-new {
    output DP-6 enable position 1920,0 mode 1920x1200
    output DP-5 enable position 3840,0 mode 1920x1200
    output eDP-1 enable position 5760,0 mode 1920x1200
}
